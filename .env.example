# ==========================================
# FIIXO ENVIRONMENT VARIABLES TEMPLATE (.env)
# ==========================================

# Core Application Settings
PROJECT_NAME="Fiixo"
ENVIRONMENT="development" # development | test | production
DEBUG=true

# Security Keys
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="fiixo_dev_super_secret_master_key_change_in_production_32b_min"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Databases
# Local SQLite for immediate zero-config start:
DATABASE_URL="sqlite+aiosqlite:///./fiixo_dev.db"
# Production PostgreSQL connection string:
# DATABASE_URL="postgresql+asyncpg://fiixo_user:password@localhost:5432/fiixo"

# Redis
REDIS_URL="redis://localhost:6379/0"

# GitHub Integration (OAuth App credentials)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:5173/integrations/github/callback"

# LLM Providers (Provider-independent layer)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
